# Out-of-Process Chaos Proxy Sidecar Container
FROM python:3.11-slim

WORKDIR /app

# Install lightweight sidecar dependencies
RUN pip install --no-cache-dir fastapi>=0.100.0 uvicorn>=0.20.0 pydantic>=2.0.0 httpx>=0.25.0

# Copy source tree
COPY src/ /app/src/

ENV PYTHONPATH=/app/src
ENV PYTHONUNBUFFERED=1

# Expose proxy traffic and control plane port
EXPOSE 8085

ENTRYPOINT ["python", "-m", "pytest_agent_chaos.sidecar.server", "--host", "0.0.0.0", "--port", "8085"]
