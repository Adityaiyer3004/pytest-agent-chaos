# Out-of-Process Chaos Proxy Sidecar Container
FROM python:3.11-slim

WORKDIR /app

# Install lightweight proxy dependencies
RUN pip install --no-cache-dir aiohttp>=3.9.0 pydantic>=2.0.0 httpx>=0.25.0

# Copy source tree
COPY src/ /app/src/

ENV PYTHONPATH=/app/src
ENV PYTHONUNBUFFERED=1

# Expose proxy traffic and control plane ports
EXPOSE 8080 8081

ENTRYPOINT ["python", "-m", "pytest_agent_chaos.proxy.server", "--host", "0.0.0.0", "--port", "8080"]
